]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[types]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="74"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[local language = require "../roblox_packages/language"

export type User = {
	read id: string,
	read name: string,
	read player: Player | false,

	disconnected: boolean,
	dirty: boolean,
	roles: { string },
}

export type Log = {
	read kind: "normal" | "info" | "warn" | "error",
	read text: string,
}

export type CommandContext = {
	read executor: User,
	read invocation_id: number | false,
}

export type AfterCommandRunContext = {
	ok: boolean,
	who: User,
	command: string,
	arguments: { unknown },
	result: { unknown },
}

export type Overload = {
	read kind: "overload",

	overloads: { language.Overload },
}

export type CommandRepresentation = {
	read name: string,
	read permissions: { string },
	read callback: (...any) -> ...any,

	read information: language.Metadata,

	dirty_replicate: boolean,
}

export type Console = {
	read vm: language.LanguageVm,
	read commands: { [string]: CommandRepresentation },
	output: (Log) -> (),
}

export type Connection = {
	read callback: (...any) -> ...any,
	read disconnect: (any) -> (),
	disconnected: boolean,
}

export type ConnectionPublic = {
	read callback: (...any) -> ...any,
	read disconnect: (any) -> (),
	read disconnected: boolean,
}

export type Signal<T...> = {
	read fire: (any, T...) -> (),
	read connect: (any, (T...) -> ()) -> Connection,
}

export type SignalPublic<T...> = {
	read connect: (any, (T...) -> ()) -> Connection,
}

export type Result = { type: "ok", results: unknown } | { type: "err" }

export type Role = string
export type Permission = string

return {}
]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="ObjectValue" referent="75"><Properties><Ref name="Value">74</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="LocalScript" referent="76"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

