-- The Script is Empty]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ConchClient]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="325"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

--// Instances
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--// Required Modules
-- Modules
local arguments = require(ReplicatedStorage.Modules.Commands)

-- Packages
local Conch = require(ReplicatedStorage.Packages.Conch)

--// Functions
-- Handles the initialization of the Conch system.
function InitializeConch()
	Conch.initiate_default_lifecycle()
	Conch.ui.bind_to(Enum.KeyCode.F2)

	-- Creates a commands container.
	local CommandsContainer = TextChatService:FindFirstChild("CustomCommands")
	if not CommandsContainer then
		CommandsContainer = Instance.new("Folder")
		CommandsContainer.Name = "CustomCommands"
		CommandsContainer.Parent = TextChatService
	end

	-- Creates a new command.
	local TextChatCommand = Instance.new("TextChatCommand")
	TextChatCommand.Name = "commands"
	TextChatCommand.PrimaryAlias = "/cmds"
	TextChatCommand.AutocompleteVisible = true
	TextChatCommand.Parent = CommandsContainer
	TextChatCommand.Triggered:Connect(function()
		local isopen = Conch.ui.opened()
		Conch.ui.opened(not isopen)
	end)
end

-- Initializes the Conch system.
InitializeConch()]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="ObjectValue" referent="326"><Properties><Ref name="Value">325</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="LocalScript" referent="327"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

