]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ConchHandler]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="303"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--// Modules
-- This module holds all the necessary information and functions.
local ConchHandler = {}

--// Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

--// Required Modules
-- ReplicatedStorage
local Conch = require(ReplicatedStorage.Packages.Conch)

-- ServerScriptService
local Commands = require(script.Commands)
local Roles = require(script.Roles)

--// Functions
-- Handles creating the premissions.
function ConchHandler.CreatePermissions()
	-- Creates the permissions.
	for Rank, Perms in Roles.Roles do
		Conch.set_role_permissions(Rank, unpack(Perms.Perms))
	end
end

-- Handles initializing the player's conch user.
function ConchHandler.Initialize(Player: Player)
	local UserRank

	-- Assigns the player's permissions.
	for UserId, Rank in Roles.SpecialUsers do
		if Player.UserId == UserId then
			UserRank = Rank
		end
	end

	-- Retrieves the group rank of the player.
	pcall(function()
		local HighestRole = 0
		local GroupRank
		for GroupId, Information:{[number]: string} in Roles.SpecialGroupRanks do
			-- Retrieves the Players rank in the group.
			local PlayerGroupRank = Player:GetRankInGroup(GroupId)

			-- Loops through the information.
			for RankLevel, Rank in Information do
				if RankLevel <= PlayerGroupRank then
					local Role = Roles.Roles[Rank]

					-- Checks if the role exists.
					if Role then
						-- Checks if the role is higher than the highest role.
						if HighestRole < Role.Level then
							HighestRole = Role.Level
							GroupRank = Rank
						end
					else
						warn(`Role {Rank} does not exist.`)
					end
				end
			end
		end

		-- Checks which rank is higher.
		local GroupRole = Roles.Roles[GroupRank]
		local UserRole = Roles.Roles[UserRank]
		local VIPLevel = Roles.Roles.VIPServer.Level

		-- Checks if the group rank is higher than the user rank.
		if GroupRole and UserRole then
			if GroupRole.Level > UserRole.Level then
				UserRank = GroupRank
			end
		elseif GroupRole and not UserRole then
			UserRank = GroupRank
		end

		-- Checks if the VIP level is higher than the user rank.
		if VIPLevel > GroupRole.Level and VIPLevel > UserRole.Level and Player.UserId == tonumber(game.PrivateServerOwnerId) then
			UserRank = "VIPServer"
		end
	end)

	-- Grants the player the permissions.
	if UserRank then
		ConchHandler.AssignPermissions(Player, UserRank)
	end
end

-- Handles the initialization of the Conch system.
function ConchHandler.InitializeConch()
	-- Creates the commands.
	task.spawn(function()
		for Command, Information in Commands do
			Conch.register(Command, Information)
		end
	end)

	-- Creates the permissions.
	Conch.initiate_default_lifecycle()
	ConchHandler.CreatePermissions()
end

-- Handles assigning the permissions to certain users.
function ConchHandler.AssignPermissions(Player: Player, Permission: string)
	local user = Conch.get_user(Player)
	Conch.give_roles(user, Permission)
end

-- Handles removing the permissions from certain users.
function ConchHandler.RemovePermissions(Player: Player, Permission: string)
	local user = Conch.get_user(Player)
	Conch.remove_roles(user, Permission)
end

--// Return Module
return ConchHandler]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="ObjectValue" referent="304"><Properties><Ref name="Value">303</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="LocalScript" referent="305"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

