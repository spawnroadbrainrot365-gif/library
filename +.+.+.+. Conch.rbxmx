]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[kick]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="311"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><Color3 name="PlaceholderColor3"><R>0.699999988079071</R><G>0.699999988079071</G><B>0.699999988079071</B></Color3><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--// Module
-- This module holds all the necessary information and functions.
local Command = {}

--// Services
local ServerScriptService = game:GetService("ServerScriptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// Required Modules
-- ReplicatedStorage
local args = require(ReplicatedStorage.Modules.Commands)

-- Packages
local Conch = require(ReplicatedStorage.Packages.Conch)

-- ServerScriptService
local Roles = require(ServerScriptService.Modules.ConchHandler.Roles)

--// Information
Command = {
	description = "Kicks the given player from the game",
	permissions = { "ModPerms" },
	arguments = function()
		return
			Conch.args.player("player", "The player that should be banned from the game"),
		Conch.args.string("public reason", "The public reason why the player has been Kicked from the game.")
	end,

	callback = function(player, reason, executor: Player)
		local Rank = Conch.get_user(player).roles[1]
		local ExecutorRank = Conch.get_user(executor).roles[1]
		local RankLevel = Roles.Roles[Rank] or {Level = 0}
		local ExecutorLevel = Roles.Roles[ExecutorRank] or {Level = 0}

		-- ensures that you cannot someone above your rank
		if RankLevel.Level < ExecutorLevel.Level then
			player:Kick(reason)
		else
			warn("attempted to kick a higher level admin.")
		end
	end
}

--// Return Module
return Command]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="ObjectValue" referent="312"><Properties><Ref name="Value">311</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="LocalScript" referent="313"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

