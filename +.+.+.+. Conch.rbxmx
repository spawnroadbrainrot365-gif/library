local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

--// Modules
-- ReplicatedStorage
local Conch = require(ReplicatedStorage.Packages.Conch)

-- ServerScriptService
local ConchHandler = require(ServerScriptService.Modules.ConchHandler)

--// Functions
-- Handles the player management.
function PlayerJoined(Player: Player)
	-- This is used to check when the player joined the experience ig.
	if Player:GetAttribute("HasJoined") then return end
	Player:SetAttribute("HasJoined", workspace:GetServerTimeNow())
	
	-- Assigns the player's conch user.
	ConchHandler.Initialize(Player)
end

-- Handles player removing.
function PlayerRemoving(Player: Player)
	-- Returns if it's not a player.
	if not Player or not Player:IsA("Player") then return end
	
	-- Do whatever here
end

--// Initializes
ConchHandler.InitializeConch()

-- Loops through all the players currently in the game.
for _, Player in pairs(Players:GetPlayers()) do
	task.defer(PlayerJoined, Player)
end

--// Connections
Players.PlayerAdded:Connect(PlayerJoined)
Players.ChildRemoved:Connect(PlayerRemoving)]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="ObjectValue" referent="321"><Properties><Ref name="Value">320</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="LocalScript" referent="322"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

